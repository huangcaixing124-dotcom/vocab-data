<!-- 设置页 -->
<view class="settings-page {{themeClass}}">
  <scroll-view scroll-y="true" enhanced="true" class="scroll-content">
    <!-- 发音设置 -->
    <view class="settings-section">
      <text class="section-title">发音设置</text>
      <view class="setting-item">
        <text class="setting-label">自动播放发音</text>
        <switch checked="{{pronunciationOpen}}" bindchange="onPronunciationToggle" color="#667eea" />
      </view>
      <view class="setting-item" wx:if="{{pronunciationOpen}}">
        <text class="setting-label">发音类型</text>
        <picker range="{{pronunciationTypes}}" range-key="label" value="{{pronunciationTypeIndex}}" bindchange="onPronunciationTypeChange">
          <text class="setting-value">{{pronunciationType === 'us' ? '美音' : '英音'}} ›</text>
        </picker>
      </view>
      <view class="setting-item" wx:if="{{pronunciationOpen}}">
        <text class="setting-label">发音语速</text>
        <picker range="{{rateOptions}}" range-key="label" value="{{pronunciationRateIndex}}" bindchange="onPronunciationRateChange">
          <text class="setting-value">{{pronunciationRate}}x ›</text>
        </picker>
      </view>
      <view class="setting-item" wx:if="{{pronunciationOpen}}">
        <text class="setting-label">循环播放</text>
        <switch checked="{{pronunciationLoop}}" bindchange="onPronunciationLoopToggle" color="#667eea" />
      </view>
      <view class="setting-item" wx:if="{{pronunciationOpen}}">
        <text class="setting-label">朗读中文释义</text>
        <switch checked="{{transRead}}" bindchange="onTransReadToggle" color="#667eea" />
      </view>
    </view>

    <!-- 音效设置 -->
    <view class="settings-section">
      <text class="section-title">音效设置</text>
      <view class="setting-item">
        <text class="setting-label">按键音</text>
        <switch checked="{{keySoundsOpen}}" bindchange="onKeySoundsToggle" color="#667eea" />
      </view>
      <view class="setting-item">
        <text class="setting-label">正确/错误提示音</text>
        <switch checked="{{hintSoundsOpen}}" bindchange="onHintSoundsToggle" color="#667eea" />
      </view>
    </view>

    <!-- 学习设置 -->
    <view class="settings-section">
      <text class="section-title">学习设置</text>
      <view class="setting-item">
        <text class="setting-label">每日目标</text>
        <view class="daily-goal-input-wrap">
          <input class="daily-goal-input" type="digit" value="{{dailyGoalTarget}}" bindblur="onDailyGoalBlur" />
          <text class="daily-goal-unit">词/天</text>
        </view>
      </view>
    </view>

    <!-- 显示设置 -->
    <view class="settings-section">
      <text class="section-title">显示设置</text>
      <view class="setting-item">
        <text class="setting-label">显示音标</text>
        <switch checked="{{phoneticOpen}}" bindchange="onPhoneticToggle" color="#667eea" />
      </view>
      <view class="setting-item" wx:if="{{phoneticOpen}}">
        <text class="setting-label">音标类型</text>
        <picker range="{{pronunciationTypes}}" range-key="label" value="{{phoneticTypeIndex}}" bindchange="onPhoneticTypeChange">
          <text class="setting-value">{{phoneticType === 'us' ? '美式' : '英式'}} ›</text>
        </picker>
      </view>
      <view class="setting-item">
        <text class="setting-label">显示前后单词</text>
        <switch checked="{{showPrevNext}}" bindchange="onShowPrevNextToggle" color="#667eea" />
      </view>
      <view class="setting-item">
        <text class="setting-label">单词字体大小</text>
        <picker range="{{fontSizeOptions}}" range-key="label" value="{{fontSizeIndex}}" bindchange="onFontSizeChange">
          <text class="setting-value">{{wordFontSize === 28 ? '小' : wordFontSize === 36 ? '中' : wordFontSize === 44 ? '大' : '特大'}} ›</text>
        </picker>
      </view>
    </view>

    <!-- 主题设置 -->
    <view class="settings-section">
      <text class="section-title">主题设置</text>
      <view class="setting-item">
        <text class="setting-label">深色模式</text>
        <switch checked="{{isDarkMode}}" bindchange="onDarkModeToggle" color="#667eea" />
      </view>
    </view>

    <!-- 练习设置 -->
    <view class="settings-section">
      <text class="section-title">练习设置</text>
      <view class="setting-item">
        <text class="setting-label">忽略大小写</text>
        <switch checked="{{ignoreCase}}" bindchange="onIgnoreCaseToggle" color="#667eea" />
      </view>
      <view class="setting-item">
        <text class="setting-label">随机顺序</text>
        <switch checked="{{randomOpen}}" bindchange="onRandomToggle" color="#667eea" />
      </view>
      <view class="setting-item">
        <text class="setting-label">默写模式</text>
        <switch checked="{{dictationOpen}}" bindchange="onDictationToggle" color="#667eea" />
      </view>
      <view class="setting-item" wx:if="{{dictationOpen}}">
        <text class="setting-label">默写类型</text>
        <picker range="{{dictationTypes}}" range-key="label" value="{{dictationTypeIndex}}" bindchange="onDictationTypeChange">
          <text class="setting-value">{{dictationType === 'hideAll' ? '隐藏全部' : dictationType === 'hideVowel' ? '隐藏元音' : dictationType === 'hideConsonant' ? '隐藏辅音' : '随机隐藏'}} ›</text>
        </picker>
      </view>
      <view class="setting-item">
        <text class="setting-label">单词循环次数</text>
        <picker range="{{loopTimesOptions}}" range-key="label" value="{{loopTimesIndex}}" bindchange="onLoopTimesChange">
          <text class="setting-value">{{loopTimes === 999999 ? '无限' : loopTimes + ' 次'}} ›</text>
        </picker>
      </view>
    </view>

    <!-- 数据管理 -->
    <view class="settings-section">
      <text class="section-title">数据管理</text>
      <view class="setting-item" bind:tap="onGoAnalysis">
        <text class="setting-label">学习统计</text>
        <text class="setting-value">查看 ›</text>
      </view>
      <view class="setting-item" bind:tap="onExportData">
        <text class="setting-label">导出数据</text>
        <text class="setting-value">›</text>
      </view>
      <view class="setting-item" bind:tap="onImportData">
        <text class="setting-label">导入数据</text>
        <text class="setting-value">›</text>
      </view>
      <view class="setting-item setting-danger" bind:tap="onClearData">
        <text class="setting-label text-danger">清空所有数据</text>
        <text class="setting-value text-danger">›</text>
      </view>
    </view>

    <!-- 关于 -->
    <view class="settings-section">
      <text class="section-title">关于</text>
      <view class="setting-item">
        <text class="setting-label">版本</text>
        <text class="setting-value text-muted">1.0.0</text>
      </view>
      <view class="setting-item">
        <text class="setting-label">基于</text>
        <text class="setting-value text-muted">Qwerty Learner (GPL-3.0)</text>
      </view>
      <view class="setting-item">
        <text class="setting-label">开源地址</text>
        <text class="setting-value text-muted" style="font-size: 22rpx;">GitHub ›</text>
      </view>
    </view>
  </scroll-view>
</view>
