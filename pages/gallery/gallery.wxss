/* 词典选择页样式 */

.gallery-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background: var(--bg-secondary);
  border-bottom: 1rpx solid var(--border);
}

.search-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  padding-right: 60rpx;
}

.search-placeholder {
  color: var(--text-muted);
}

.search-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 24rpx;
}

/* 分类标签 */
.category-scroll {
  background: var(--bg-secondary);
  border-bottom: 1rpx solid var(--border);
  white-space: nowrap;
}

.category-tabs {
  display: inline-flex;
  padding: 16rpx 30rpx;
  gap: 16rpx;
}

.category-tab {
  display: inline-flex;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  white-space: nowrap;
  transition: all 0.2s;
}

/* 词典列表 */
.dict-list {
  flex: 1;
  overflow: hidden;
  background: var(--bg-primary);
}

.dict-list-inner {
  padding: 20rpx 30rpx;
}

/* 搜索结果分区标题 */
.section-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 16rpx 0 8rpx;
}

/* 单词搜索结果 */
.word-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
}

.word-result-item:active {
  opacity: 0.7;
}

.word-result-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.word-result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.word-result-trans {
  font-size: 24rpx;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.word-result-dict {
  font-size: 22rpx;
  color: var(--text-muted);
  background: var(--bg-tertiary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
