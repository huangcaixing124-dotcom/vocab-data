/* 错题本样式 */

.error-book-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
}

.toolbar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  background: var(--bg-secondary);
  border-bottom: 1rpx solid var(--border);
  align-items: center;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.search-placeholder {
  color: var(--text-muted);
}

.error-list {
  flex: 1;
  overflow: hidden;
}

.error-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border);
  transition: background 0.2s;
}

.error-item:active {
  background: var(--bg-tertiary);
}

.error-item-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.error-word {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  font-family: 'SF Mono', monospace;
}

.error-dict {
  font-size: 22rpx;
}

.error-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.error-badge {
  min-width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(252, 129, 129, 0.15);
  border-radius: 50%;
}

.error-badge-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--danger);
}

.error-arrow {
  font-size: 36rpx;
}

/* 分页 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  padding: 20rpx;
  background: var(--bg-secondary);
  border-top: 1rpx solid var(--border);
}

.page-info {
  font-size: 26rpx;
  color: var(--text-muted);
}

.disabled {
  opacity: 0.3;
  pointer-events: none;
}

/* 详情弹窗 */
.detail-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.detail-word {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-family: 'SF Mono', monospace;
}

.sound-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-tertiary);
  border-radius: 50%;
  font-size: 28rpx;
}

.detail-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.detail-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: var(--bg-tertiary);
  border-radius: 12rpx;
}

.detail-stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.detail-stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.detail-dict {
  font-size: 24rpx;
  margin-bottom: 24rpx;
  display: block;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.btn-danger {
  background: rgba(252, 129, 129, 0.2);
  color: var(--danger);
  border: 1rpx solid rgba(252, 129, 129, 0.3);
}

.empty-icon {
  font-size: 64rpx;
}
