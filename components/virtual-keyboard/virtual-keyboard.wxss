/* 虚拟键盘样式 */

.keyboard {
  padding: 10rpx 8rpx 20rpx;
  background: var(--bg-secondary);
  border-top: 1rpx solid var(--border);
}

.keyboard-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

/* QWERTY 行错位布局 */
.keyboard-row:nth-child(2) {
  padding-left: 28rpx;
}

.keyboard-row:nth-child(3) {
  padding-left: 56rpx;
}

.keyboard-row-bottom {
  justify-content: center;
  margin-top: 4rpx;
  padding-left: 0 !important;
}

.key {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: var(--bg-tertiary);
  border: 1rpx solid var(--border);
  transition: all 0.15s ease;
  position: relative;
}

.key-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-transform: uppercase;
  user-select: none;
}

/* 按下状态 */
.key-pressed {
  background: var(--accent-primary);
  transform: scale(0.95);
  border-color: var(--accent-primary);
}

.key-pressed .key-text {
  color: #fff;
}

/* 预期字母高亮提示 */
.key-hint {
  background: rgba(102, 126, 234, 0.15);
  border-color: var(--accent-primary);
}

.key-hint .key-text {
  color: var(--accent-primary);
  font-weight: 600;
}

/* 正确反馈 */
.key-correct {
  background: var(--success);
  border-color: var(--success);
  animation: keyFlashCorrect 0.3s ease;
}

.key-correct .key-text {
  color: #fff;
}

/* 错误反馈 */
.key-wrong {
  background: var(--danger);
  border-color: var(--danger);
  animation: keyFlashWrong 0.3s ease;
}

.key-wrong .key-text {
  color: #fff;
}

/* 空格键 */
.key-space {
  width: 320rpx;
  height: 72rpx;
}

.key-space .key-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 动画 */
@keyframes keyFlashCorrect {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

@keyframes keyFlashWrong {
  0% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  50% { transform: translateX(4rpx); }
  75% { transform: translateX(-4rpx); }
  100% { transform: translateX(0); }
}
